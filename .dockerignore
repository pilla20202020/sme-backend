# Dependencies (reinstalled inside the image)
node_modules
npm-debug.log*

# Build output (regenerated by the build stage)
dist
build

# Version control & CI
.git
.gitignore
.github

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Docker
Dockerfile
.dockerignore

# Tests & docs
coverage
*.md

# Local env files that must NOT leak into the image
# (NOTE: .env is intentionally NOT ignored — entrypoint.sh sources it
#  and the production stage copies it from the builder.)
.env.local
.env.*.local
